{
  "name": "@madeup-video/admin",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/admin/src",
  "projectType": "application",
  "tags": ["type:app", "runtime:browser", "scope:rental"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/admin"],
      "inputs": ["default", "^default", { "env": "VITE_API_URL" }],
      "options": {
        "cwd": "apps/admin",
        "command": "pnpm exec vite build"
      }
    },
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/admin",
        "command": "pnpm exec vite"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec eslint apps/admin"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": ".",
        "command": "pnpm exec tsc --noEmit -p apps/admin/tsconfig.json"
      }
    }
  }
}
