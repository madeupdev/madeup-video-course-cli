{
  "name": "@madeup-video/course",
  "version": "0.0.0-development",
  "description": "Prepared-code and recovery tooling for the Made Up Video advanced monorepos course",
  "type": "module",
  "private": false,
  "license": "SEE LICENSE IN LICENSE.md",
  "bin": {
    "madeup-video-course": "./dist/cli.js"
  },
  "files": [
    "dist",
    "recipes",
    "!recipes/fixtures",
    "recovery"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:recovery-assets": "node dist/scripts/build-recovery-assets.js",
    "lint": "eslint .",
    "pack:inspect": "node scripts/inspect-pack.ts",
    "test": "vitest run",
    "test:inspect-pack": "vitest run tests/scripts/inspect-pack.test.ts",
    "test:replay": "vitest run tests/replay/replay.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.17.0"
  },
  "packageManager": "pnpm@11.17.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madeupdev/madeup-video-course-cli.git"
  },
  "homepage": "https://github.com/madeupdev/madeup-video-course-cli#readme",
  "bugs": {
    "url": "https://github.com/madeupdev/madeup-video-course-cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "@types/tar-stream": "3.1.4",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "tar-stream": "3.2.0",
    "zod": "4.4.3"
  }
}
